{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false, "defaultGradients": false, "defaultDuotone": false, "custom": false, "customGradient": false,
      "palette": [
        { "slug": "paper", "color": "#F1EFE8", "name": "Paper" },
        { "slug": "paper-2", "color": "#E6E3D8", "name": "Paper 2" },
        { "slug": "card", "color": "#FAF9F5", "name": "Card" },
        { "slug": "ink", "color": "#13231B", "name": "Ink" },
        { "slug": "muted", "color": "#56645B", "name": "Muted" },
        { "slug": "line", "color": "#D5D1C3", "name": "Line" },
        { "slug": "forest", "color": "#0F3D2B", "name": "Forest" },
        { "slug": "forest-2", "color": "#17503A", "name": "Forest 2" },
        { "slug": "forest-3", "color": "#2A6B4E", "name": "Forest 3" },
        { "slug": "gold", "color": "#E2A93B", "name": "Jagung (aksen)" },
        { "slug": "gold-soft", "color": "#F4E3BC", "name": "Jagung muda" },
        { "slug": "cream", "color": "#EAE8D6", "name": "Cream" },
        { "slug": "night", "color": "#08140F", "name": "Night" },
        { "slug": "night-2", "color": "#0F2119", "name": "Night 2" },
        { "slug": "sage", "color": "#8E9C91", "name": "Sage (teks redup di gelap)" }
      ]
    },
    "typography": {
      "defaultFontSizes": false, "customFontSize": false, "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Plus Jakarta Sans",
          "fontFamily": "\"Plus Jakarta Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Plus Jakarta Sans", "fontWeight": "400", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plus-jakarta-sans-400.woff2"] },
            { "fontFamily": "Plus Jakarta Sans", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plus-jakarta-sans-500.woff2"] },
            { "fontFamily": "Plus Jakarta Sans", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plus-jakarta-sans-600.woff2"] },
            { "fontFamily": "Plus Jakarta Sans", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/plus-jakarta-sans-700.woff2"] }
          ] },
        { "slug": "serif", "name": "Instrument Serif",
          "fontFamily": "\"Instrument Serif\", Georgia, \"Times New Roman\", serif",
          "fontFace": [
            { "fontFamily": "Instrument Serif", "fontWeight": "400", "fontStyle": "italic", "fontDisplay": "swap", "src": ["file:./assets/fonts/instrument-serif-italic.woff2"] }
          ] }
      ],
      "fontSizes": [
        { "slug": "xs", "size": "12px", "name": "XS", "fluid": false },
        { "slug": "sm", "size": "14px", "name": "S", "fluid": false },
        { "slug": "base", "size": "16px", "name": "Base", "fluid": false },
        { "slug": "md", "size": "18px", "name": "M", "fluid": false },
        { "slug": "lg", "size": "22px", "name": "L", "fluid": false },
        { "slug": "xl", "size": "28px", "name": "XL", "fluid": { "min": "24px", "max": "28px" } },
        { "slug": "2xl", "size": "40px", "name": "2XL", "fluid": { "min": "28px", "max": "40px" } },
        { "slug": "3xl", "size": "56px", "name": "3XL", "fluid": { "min": "32px", "max": "56px" } },
        { "slug": "display", "size": "84px", "name": "Display", "fluid": { "min": "40px", "max": "84px" } },
        { "slug": "mega", "size": "148px", "name": "Mega", "fluid": { "min": "52px", "max": "148px" } }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "size": "8px", "name": "1" },
        { "slug": "30", "size": "16px", "name": "2" },
        { "slug": "40", "size": "24px", "name": "3" },
        { "slug": "50", "size": "clamp(32px, 4vw, 48px)", "name": "4" },
        { "slug": "60", "size": "clamp(48px, 6vw, 72px)", "name": "5" },
        { "slug": "70", "size": "clamp(72px, 10vw, 128px)", "name": "6" }
      ]
    },
    "custom": {
      "ease": "cubic-bezier(.16,1,.3,1)",
      "radius": { "lg": "28px", "md": "18px", "pill": "999px" },
      "gutter": "clamp(16px, 4vw, 40px)"
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--sans)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.6" },
    "spacing": {
      "padding": { "left": "var(--wp--custom--gutter)", "right": "var(--wp--custom--gutter)", "top": "0", "bottom": "0" },
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "elements": {
      "heading": { "typography": { "fontWeight": "600", "letterSpacing": "-0.03em", "lineHeight": "1.02" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "0.98", "letterSpacing": "-0.045em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--3-xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--lg)", "letterSpacing": "-0.02em" } },
      "link": { "color": { "text": "var(--wp--preset--color--forest-2)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--gold)", "text": "var(--wp--preset--color--ink)" },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "600", "fontSize": "15px" },
        "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "22px", "right": "22px" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--gold)", "text": "var(--wp--preset--color--ink)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Halaman tanpa judul", "postTypes": ["page"] }
  ]
}
